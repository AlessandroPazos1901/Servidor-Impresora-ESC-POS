# ===========================================
# CONFIGURACIÓN DE IMPRESORA TÉRMICA
# ===========================================

# IP de la impresora en tu red local
PRINTER_IP=192.168.1.200

# Puerto de la impresora (típicamente 9100 para ESC/POS)
PRINTER_PORT=9100

# Puerto del servidor local
PORT=3001

# ===========================================
# SEGURIDAD
# ===========================================

# Token secreto para autenticación de requests
# IMPORTANTE: Genera uno único con: node -e "console.log(require('crypto').randomUUID())"
PRINT_SERVER_SECRET=tu-secreto-muy-largo-y-dificil-de-adivinar

# ===========================================
# CONFIGURACIÓN DE NGROK
# ===========================================

# Token de autenticación de ngrok (REQUERIDO)
# Obtén tu token en: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=tu_authtoken_aqui

# Dominio estático de ngrok (OPCIONAL - solo para ngrok Pro)
# Si tienes ngrok Pro, puedes usar un dominio estático que no cambie entre reinicios
# Ejemplo: mi-impresora.ngrok-free.app
# Déjalo vacío si usas el plan gratuito
NGROK_DOMAIN=

# ===========================================
# CONFIGURACIÓN DE DOCKER (Opcional)
# ===========================================

# Activar/desactivar ngrok en Docker
# true = usar ngrok (recomendado para producción)
# false = solo servidor HTTP local
USE_NGROK=true

# ===========================================
# INSTRUCCIONES
# ===========================================
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Edita .env con tus valores reales
# 3. NUNCA subas el archivo .env a git (ya está en .gitignore)
# 4. Para generar un PRINT_SERVER_SECRET seguro:
#    node -e "console.log(require('crypto').randomUUID())"