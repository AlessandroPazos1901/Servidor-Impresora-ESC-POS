# Configuración de la Impresora Térmica
# Copia este archivo a .env y personaliza los valores

# IP y Puerto de la Impresora Térmica
PRINTER_IP=192.168.1.200
PRINTER_PORT=9100

# Token Secreto para Autorización (CAMBIAR OBLIGATORIAMENTE)
# Generar un token seguro: https://www.uuidgenerator.net/
PRINT_SERVER_SECRET=your-very-secure-secret-token-here

# Configuración del Servidor
# USE_HTTPS=true     # true para HTTPS (default), false para HTTP
# SERVER_IP=auto     # auto-detecta IP, o especifica una IP manualmente
# PORT=3001          # Puerto del servidor (default: 3001)

# Configuración Adicional (opcional)
NODE_ENV=production
TZ=America/Lima

# NOTAS IMPORTANTES:
# - Los certificados SSL se generan automáticamente para la IP detectada
# - Si USE_HTTPS=false, el servidor usará HTTP (no recomendado para producción)
# - El servidor detecta automáticamente la IP local de la red
# - Los certificados son auto-firmados (acepta la advertencia en el navegador)